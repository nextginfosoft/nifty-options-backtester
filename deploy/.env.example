# Copy to deploy/.env and fill in. NEVER commit deploy/.env.

# Public hostname pointing at this server (A record -> VPS IP). Caddy gets the TLS cert for it.
# For a local HTTPS test use: DOMAIN=localhost
DOMAIN=dashboard.example.com

# Dashboard login (single user). Generate with:  openssl rand -base64 24
DASHBOARD_PASSWORD=
# Cookie-signing key, at least 32 chars. Generate with:  openssl rand -hex 32
SESSION_SECRET=
# Session length in hours
SESSION_HOURS=12

# Starting capital shown when no journal is selected (rupees)
PAPER_INITIAL_CAPITAL=2500000

# Zerodha Kite Connect (optional). Get a key + secret at https://developers.kite.trade/
# and set the app's redirect URL to https://<DOMAIN>/api/broker/kite/callback
KITE_API_KEY=
KITE_API_SECRET=

# Encrypts Zerodha credentials saved from the dashboard (>= 32 chars). REQUIRED to use that form;
# keep it separate from the data volume. Generate with:  openssl rand -hex 32
# Changing it makes previously saved credentials unreadable (re-enter them).
CREDENTIALS_KEY=
