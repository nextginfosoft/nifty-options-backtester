# Fyers API Configuration (LOCAL - Not committed to git)
#
# This file is a TEMPLATE. Copy it to .env.local and fill in your credentials.
# .env.local is in .gitignore and will NOT be committed.
#
# How to get credentials:
# 1. Go to https://www.fyers.in/
# 2. Create/login to your account
# 3. Visit https://developers.fyers.in/
# 4. Create an app and get credentials
#
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.local.template .env.local
#
# 2. Edit .env.local and replace YOUR_* values with actual credentials:
#    FYERS_CLIENT_ID=YOUR_CLIENT_ID_HERE
#    FYERS_API_SECRET=YOUR_API_SECRET_HERE
#
# 3. Run test to verify:
#    python scripts/test_fyers_live.py
#
# WARNING: Never commit .env.local to git. It's in .gitignore for security.

# Fyers API Client ID (from https://developers.fyers.in/)
FYERS_CLIENT_ID=YOUR_CLIENT_ID_HERE

# Fyers API Secret (from https://developers.fyers.in/)
FYERS_API_SECRET=YOUR_API_SECRET_HERE

# Fyers Access Token (auto-filled after first auth)
# Leave empty - will be updated after successful login
FYERS_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Zerodha Kite Connect (alternative to Fyers)
# Set BROKER=kite to use Kite for live quotes / option chain.
# Get an API key + secret at https://developers.kite.trade/ (a data-enabled
# Kite Connect plan is needed for live quotes). Set the app's redirect URL to
# something like http://127.0.0.1 and copy the request_token from it when
# running: python scripts/generate_kite_token.py
# ---------------------------------------------------------------------------
BROKER=kite
KITE_API_KEY=YOUR_KITE_API_KEY
KITE_API_SECRET=YOUR_KITE_API_SECRET
# Auto-filled daily by scripts/generate_kite_token.py
KITE_ACCESS_TOKEN=
